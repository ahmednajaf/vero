# Local PostgreSQL only. These are development credentials, not production secrets.
POSTGRES_USER=sbi
POSTGRES_PASSWORD=sbi_local_dev
POSTGRES_DB=sbi
POSTGRES_PORT=5432

# The API loads backend/.env explicitly, NOT this root file.
# OpenAI is the active AI provider. No automatic provider fallback.
DATABASE_URL=postgresql+psycopg://vero@127.0.0.1:55433/vero
AI_PROVIDER=openai
KNOWLEDGE_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_ALLOWED_MODELS=["gpt-5.4-mini-2026-03-17"]
OPENAI_DAILY_TOKEN_LIMIT=2000000
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4000
# Standard USD / 1M tokens, verified 2026-10-07. Recheck when changing model.
OPENAI_INPUT_PRICE=0.75
OPENAI_OUTPUT_PRICE=4.5
# App-local monthly cap. No credits are bought and no calls run at startup.
KNOWLEDGE_MONTHLY_BUDGET_USD=5
