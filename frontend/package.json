{
  "name": "sustainability-benchmarking-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "npm run typecheck && vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native"
  },
  "dependencies": {
    "cobe": "2.0.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.38.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
