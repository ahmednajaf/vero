# Browser-visible configuration: do not place secrets in VITE_ variables.
VITE_API_BASE_URL=/api

# Optional public sales address. Blank keeps enquiries as downloadable drafts.
# This is not a secret. Requests are never claimed as sent by the website.
VITE_SALES_EMAIL=

# Used only by the local Vite development proxy.
API_PROXY_TARGET=http://127.0.0.1:8000
