APP_ENV=development
API_TITLE=Vero API
REPORTING_YEAR=2025

# Keep this aligned with the local PostgreSQL configuration.
DATABASE_URL=postgresql+psycopg://vero@127.0.0.1:55433/vero
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Official report acquisition, sequential and operator initiated.
# REPORTS_ROOT defaults to repository-root/data/reports (absolute path recommended).
DISCOVERY_USER_AGENT=SustainabilityBenchmarkResearch/0.1
DISCOVERY_DELAY_SECONDS=1
DISCOVERY_TIMEOUT_SECONDS=15
DISCOVERY_RETRIES=2
DISCOVERY_MAX_PAGES=18
DISCOVERY_MAX_DEPTH=3
DISCOVERY_MAX_CANDIDATES=100
DISCOVERY_MAX_REQUESTS=80
DISCOVERY_MAX_DOWNLOAD_MB=100
DISCOVERY_ALLOW_JS=false
# Optional RFC 9309 unavailable-robots rule for exact company-published CDN PDFs.
# Never ignores published exclusions, authentication, challenges or PDF-level 403s.
DISCOVERY_ALLOW_UNAVAILABLE_ROBOTS_FOR_LINKED_DOCUMENTS=false
# JSON keyed by company UUID; only manually verified company-owned DNS domains.
# Do not add generic third-party CDN or mirror domains to make a blocked job pass.
DISCOVERY_OFFICIAL_DOMAINS={}

# Page-aware parsing. No AI model, OCR engine or external service is called.
PARSE_CHUNK_CHARS=2400
PARSE_MAX_PAGES=1500
PARSE_MAX_PAGE_CHARS=300000
PARSE_MAX_DOCUMENT_CHARS=25000000
PARSE_TIMEOUT_SECONDS=300
PARSE_MAX_TABLES_PER_PAGE=50
PARSE_PDFPLUMBER_FALLBACK=true

# Operator-run acquisition; no model calls during download/indexing.
PIPELINE_COMPANY_WORKERS=2
PIPELINE_PARSE_WORKERS=1
PIPELINE_JOB_MAX_ATTEMPTS=3
# Stop queued work after a failure; this never relaxes checkpoint requirements.
PIPELINE_FAIL_FAST=true
# PIPELINE_ROOT defaults to backend/storage/pipeline (versioned JSON/CSV exports).

# Vero uses OpenAI only. Never paste a key into chat or VITE_* variables.
# Search and ingestion still work without a key; startup never makes AI calls.
AI_PROVIDER=openai
KNOWLEDGE_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_ALLOWED_MODELS=["gpt-5.4-mini-2026-03-17"]
# Vero-only guard. This cannot see other apps' organization-wide usage.
OPENAI_DAILY_TOKEN_LIMIT=2000000
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=4000
# Standard list rates; not actual billing after data-sharing incentives. Verified 2026-10-08.
# Recheck the rates if you change model. No automatic provider/model fallback.
# Zero rates or budget block calls. Conservative reservations survive unknown outcomes.
OPENAI_INPUT_PRICE=0.75
OPENAI_OUTPUT_PRICE=4.5
KNOWLEDGE_MONTHLY_BUDGET_USD=5
KNOWLEDGE_MAX_EVIDENCE_CHARS=30000
